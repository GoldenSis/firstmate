# Example config/kestra.env for firstmate's Kestra execution seam.
#
# Copy to config/kestra.env in your firstmate home and fill in real values. That
# path is gitignored: no endpoint and no credential belongs in kestra/ or bin/.
# Run `chmod 0600 config/kestra.env` after copying; the seam refuses any other mode.
#
# Kestra OSS authenticates one broad Basic Auth identity that can create, execute,
# replay, change state, and delete through the same API. Treat this file as a
# disclosure risk: keep it mode 0600, and never paste its values into a command
# line, a log, or a chat message.

# Loopback only. The seam refuses any host other than 127.0.0.1, localhost, or
# [::1], because M1 binds Kestra's main and management servers to loopback.
FM_KESTRA_BASE_URL=http://127.0.0.1:18080

# Kestra's tenant segment in the API path. OSS local mode uses "main".
FM_KESTRA_TENANT=main

# The ONE allow-listed namespace. It must equal the namespace the tracked flows
# under kestra/flows/ declare, or the deployer refuses to run.
FM_KESTRA_NAMESPACE=firstmate.m1

# Basic Auth identity. No value is committed anywhere in this repo.
FM_KESTRA_USER=
FM_KESTRA_PASSWORD=
